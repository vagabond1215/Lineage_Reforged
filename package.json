{
  "name": "survival-builder-rpg-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tool:content-lint": "node ./tools/content-lint/index.mjs",
    "tool:db-build": "node ./tools/db-build/index.mjs",
    "tool:scenario": "node ./tools/scenario-runner/index.mjs",
    "ui:dev": "npm --prefix ./apps/rpg-ui run dev",
    "ui:dev:host": "npm --prefix ./apps/rpg-ui run dev -- --host 127.0.0.1 --port 5173",
    "ui:build": "npm --prefix ./apps/rpg-ui run build",
    "ui:preview": "npm --prefix ./apps/rpg-ui run preview",
    "typecheck": "npm run typecheck:ui",
    "typecheck:ui": "npm --prefix ./apps/rpg-ui run typecheck",
    "typecheck:ui:node": "npm --prefix ./apps/rpg-ui run typecheck:node",
    "typecheck:workspace": "npm --prefix ./apps/rpg-ui exec -- tsc --noEmit -p tsconfig.json",
    "pretest": "npm run tool:no-new-hex-dependencies",
    "test": "node --test",
    "tool:no-new-hex-dependencies": "node ./scripts/check-no-new-hex-dependencies.mjs --check",
    "test:coordinate-foundation": "node --test ./tests/unit/world-coordinate-geometry.test.mjs ./tests/unit/legacy-hex-forward-gate.test.mjs ./tests/unit/kaelvar-five-region-candidate-audit.test.mjs"
  }
}
