{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "ItemRecord",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "id",
                     "itemKey",
                     "name",
                     "itemClass",
                     "itemBranch",
                     "itemSubBranch",
                     "baseValue",
                     "currencyId",
                     "valueUnit",
                     "marketable",
                     "valueProfile"
                 ],
    "properties":  {
                       "id":  {
                                  "type":  "string"
                              },
                       "itemKey":  {
                                       "type":  "string",
                                       "pattern":  "^(?:[a-z0-9]+(?:_[a-z0-9]+)*|[a-z]+\\.[a-z0-9]+(?:_[a-z0-9]+)*)$"
                                   },
                       "name":  {
                                    "type":  "string"
                                },
                       "itemClass":  {
                                         "type":  "string",
                                         "enum":  [
                                                      "vehicle",
                                                      "consumable",
                                                      "commodity",
                                                      "clothing",
                                                      "tool",
                                                      "armor",
                                                      "weapon",
                                                      "accessory"
                                                  ]
                                     },
                       "itemBranch":  {
                                          "type":  "string"
                                      },
                       "itemSubBranch":  {
                                             "type":  "string"
                                         },
                       "baseValue":  {
                                         "type":  "number",
                                         "minimum":  0
                                     },
                       "currencyId":  {
                                          "type":  "string"
                                      },
                       "valueUnit":  {
                                         "type":  "string"
                                     },
                       "marketable":  {
                                          "type":  "boolean"
                                      },
                       "valueProfile":  {
                                            "type":  "object",
                                            "additionalProperties":  false,
                                            "required":  [
                                                             "valueMode",
                                                             "materialCostModel",
                                                             "laborIntensity",
                                                             "processingIntensity",
                                                             "difficultyTier",
                                                             "demandBand"
                                                         ],
                                            "properties":  {
                                                               "valueMode":  {
                                                                                 "type":  "string",
                                                                                 "enum":  [
                                                                                              "source_derived",
                                                                                              "recipe_derived"
                                                                                          ]
                                                                             },
                                                               "materialCostModel":  {
                                                                                         "type":  "string",
                                                                                         "enum":  [
                                                                                                      "source_effort",
                                                                                                      "input_rollup"
                                                                                                  ]
                                                                                     },
                                                               "laborIntensity":  {
                                                                                       "type":  "string",
                                                                                       "enum":  [
                                                                                                    "light",
                                                                                                    "moderate",
                                                                                                    "heavy"
                                                                                                ]
                                                                                   },
                                                               "processingIntensity":  {
                                                                                            "type":  "string",
                                                                                            "enum":  [
                                                                                                         "minimal",
                                                                                                         "standard",
                                                                                                         "fuel_heavy",
                                                                                                         "precision"
                                                                                                     ]
                                                                                        },
                                                               "difficultyTier":  {
                                                                                      "type":  "string",
                                                                                      "enum":  [
                                                                                                   "easy",
                                                                                                   "moderate",
                                                                                                   "hard",
                                                                                                   "expert"
                                                                                               ]
                                                                                  },
                                                               "demandBand":  {
                                                                                  "type":  "string",
                                                                                  "enum":  [
                                                                                               "subsistence",
                                                                                               "common",
                                                                                               "utility",
                                                                                               "specialty",
                                                                                               "luxury"
                                                                                           ]
                                                                              }
                                                           }
                                        },
                       "materialDifficultyProfile":  {
                                                        "type":  "object",
                                                        "additionalProperties":  false,
                                                        "required":  [
                                                                         "family",
                                                                         "workability",
                                                                         "hardness",
                                                                         "refinementDifficulty",
                                                                         "processingCostImpact"
                                                                     ],
                                                        "properties":  {
                                                                           "family":  {
                                                                                          "type":  "string",
                                                                                          "enum":  [
                                                                                                       "wood",
                                                                                                       "metal",
                                                                                                       "textile",
                                                                                                       "leather"
                                                                                                   ]
                                                                                      },
                                                                           "workability":  {
                                                                                               "type":  "string",
                                                                                               "enum":  [
                                                                                                            "easy",
                                                                                                            "moderate",
                                                                                                            "hard"
                                                                                                        ]
                                                                                           },
                                                                           "hardness":  {
                                                                                            "type":  "string",
                                                                                            "enum":  [
                                                                                                         "soft",
                                                                                                         "medium",
                                                                                                         "hard"
                                                                                                     ]
                                                                                        },
                                                                           "refinementDifficulty":  {
                                                                                                        "type":  "string",
                                                                                                        "enum":  [
                                                                                                                     "low",
                                                                                                                     "moderate",
                                                                                                                     "high"
                                                                                                                 ]
                                                                                                    },
                                                                           "processingCostImpact":  {
                                                                                                       "type":  "string",
                                                                                                       "enum":  [
                                                                                                                    "light",
                                                                                                                    "moderate",
                                                                                                                    "heavy"
                                                                                                                ]
                                                                                                   }
                                                                       }
                                                    },
                       "roles":  {
                                     "type":  "array",
                                     "items":  {
                                                   "type":  "string",
                                                   "enum":  [
                                                                "consumable",
                                                                "ingredient",
                                                                "material",
                                                                "reagent",
                                                                "trade_good",
                                                                "fuel"
                                                            ]
                                               },
                                     "uniqueItems":  true
                                 },
                       "tags":  {
                                    "type":  "array",
                                    "items":  {
                                                  "type":  "string",
                                                  "pattern":  "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                                              },
                                    "uniqueItems":  true
                                },
                       "processingGroups":  {
                                               "type":  "array",
                                               "items":  {
                                                             "type":  "string",
                                                             "pattern":  "^[a-z0-9]+(?:[._][a-z0-9]+)*$"
                                                         },
                                               "uniqueItems":  true
                                           },
                       "stage":  {
                                     "type":  "string",
                                     "enum":  [
                                                  "raw",
                                                  "refined",
                                                  "processed",
                                                  "finished"
                                              ]
                                 },
                       "aliasKeys":  {
                                         "type":  "array",
                                         "items":  {
                                                       "type":  "string",
                                                       "minLength":  1
                                                   },
                                         "uniqueItems":  true
                                     },
                       "consumableProfileId":  {
                                                   "type":  "string"
                                               },
                       "spoilageProfileId":  {
                                                "type":  "string"
                                            },
                       "useProfiles":  {
                                           "type":  "array",
                                           "items":  {
                                                         "type":  "object",
                                                         "additionalProperties":  false,
                                                         "required":  [
                                                                          "actionType",
                                                                          "primarySkillId",
                                                                          "supportSkillIds",
                                                                          "requiredSkillRank",
                                                                          "masteryRank",
                                                                          "effectChannels"
                                                                      ],
                                                         "properties":  {
                                                                            "actionType":  {
                                                                                               "type":  "string"
                                                                                           },
                                                                            "primarySkillId":  {
                                                                                                   "type":  "string"
                                                                                               },
                                                                            "supportSkillIds":  {
                                                                                                     "type":  "array",
                                                                                                     "items":  {
                                                                                                                   "type":  "string"
                                                                                                               },
                                                                                                     "uniqueItems":  true
                                                                                                 },
                                                                            "requiredSkillRank":  {
                                                                                                       "type":  "integer",
                                                                                                       "minimum":  0,
                                                                                                       "maximum":  125
                                                                                                   },
                                                                            "masteryRank":  {
                                                                                                "type":  "integer",
                                                                                                "minimum":  0,
                                                                                                "maximum":  125
                                                                                            },
                                                                            "effectChannels":  {
                                                                                                   "type":  "array",
                                                                                                   "items":  {
                                                                                                                 "type":  "string"
                                                                                                             },
                                                                                                   "minItems":  1,
                                                                                                   "uniqueItems":  true
                                                                                               },
                                                                            "handlingType":  {
                                                                                                  "type":  "string",
                                                                                                  "enum":  [
                                                                                                               "weapon",
                                                                                                               "shield",
                                                                                                               "armor",
                                                                                                               "tool",
                                                                                                               "hybrid"
                                                                                                           ]
                                                                                              },
                                                                            "proficiencySkillId":  {
                                                                                                         "type":  "string"
                                                                                                     },
                                                                            "hybridSkillIds":  {
                                                                                                   "type":  "array",
                                                                                                   "items":  {
                                                                                                                 "type":  "string"
                                                                                                             },
                                                                                                   "uniqueItems":  true
                                                                                               },
                                                                            "combatTags":  {
                                                                                               "type":  "array",
                                                                                               "items":  {
                                                                                                             "type":  "string"
                                                                                                         },
                                                                                               "uniqueItems":  true
                                                                                           },
                                                                            "resolutionHooks":  {
                                                                                                    "type":  "array",
                                                                                                    "items":  {
                                                                                                                  "type":  "string"
                                                                                                              },
                                                                                                    "uniqueItems":  true
                                                                                                },
                                                                            "grantTags":  {
                                                                                              "type":  "array",
                                                                                              "items":  {
                                                                                                            "type":  "string"
                                                                                                        },
                                                                                              "uniqueItems":  true
                                                                                          },
                                                                            "targetProfile":  {
                                                                                                  "type":  "object",
                                                                                                  "additionalProperties":  false,
                                                                                                  "required":  [
                                                                                                                   "disposition",
                                                                                                                   "shape",
                                                                                                                   "range",
                                                                                                                   "maxTargets",
                                                                                                                   "requiresAccuracy"
                                                                                                               ],
                                                                                                  "properties":  {
                                                                                                                     "disposition":  {
                                                                                                                                          "type":  "string",
                                                                                                                                          "enum":  [
                                                                                                                                                       "ally",
                                                                                                                                                       "enemy",
                                                                                                                                                       "self",
                                                                                                                                                       "any"
                                                                                                                                                   ]
                                                                                                                                      },
                                                                                                                     "shape":  {
                                                                                                                                   "type":  "string"
                                                                                                                               },
                                                                                                                     "range":  {
                                                                                                                                   "type":  "string"
                                                                                                                               },
                                                                                                                     "maxTargets":  {
                                                                                                                                         "type":  "integer",
                                                                                                                                         "minimum":  1
                                                                                                                                     },
                                                                                                                     "requiresAccuracy":  {
                                                                                                                                                 "type":  "boolean"
                                                                                                                                             }
                                                                                                                 }
                                                                                              },
                                                                            "activation":  {
                                                                                               "type":  "object",
                                                                                               "additionalProperties":  false,
                                                                                               "required":  [
                                                                                                                "type",
                                                                                                                "actionType",
                                                                                                                "timing",
                                                                                                                "executionTimeTicks",
                                                                                                                "recoveryTimeTicks",
                                                                                                                "interruptible",
                                                                                                                "costs"
                                                                                                            ],
                                                                                               "properties":  {
                                                                                                                  "type":  {
                                                                                                                               "type":  "string",
                                                                                                                               "enum":  [
                                                                                                                                            "active",
                                                                                                                                            "reaction",
                                                                                                                                            "passive"
                                                                                                                                        ]
                                                                                                                           },
                                                                                                                  "actionType":  {
                                                                                                                                     "type":  "string"
                                                                                                                                 },
                                                                                                                  "timing":  {
                                                                                                                                 "type":  "string"
                                                                                                                             },
                                                                                                                  "executionTimeTicks":  {
                                                                                                                                               "type":  "integer",
                                                                                                                                               "minimum":  0
                                                                                                                                           },
                                                                                                                  "recoveryTimeTicks":  {
                                                                                                                                              "type":  "integer",
                                                                                                                                              "minimum":  0
                                                                                                                                          },
                                                                                                                  "interruptible":  {
                                                                                                                                      "type":  "boolean"
                                                                                                                                  },
                                                                                                                  "costs":  {
                                                                                                                                "type":  "object",
                                                                                                                                "additionalProperties":  false,
                                                                                                                                "properties":  {
                                                                                                                                                   "hp":  {
                                                                                                                                                              "type":  "number",
                                                                                                                                                              "minimum":  0
                                                                                                                                                          },
                                                                                                                                                   "mp":  {
                                                                                                                                                              "type":  "number",
                                                                                                                                                              "minimum":  0
                                                                                                                                                          },
                                                                                                                                                   "stamina":  {
                                                                                                                                                                   "type":  "number",
                                                                                                                                                                   "minimum":  0
                                                                                                                                                               }
                                                                                                                                               }
                                                                                                                            }
                                                                                                              }
                                                                                           }
                                                                        }
                                                     }
                                            }
                   }
}
