{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackstoryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "description", "startingSkills"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "description": { "type": "string" },
    "attributeAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "STR": { "type": "integer" },
        "DEX": { "type": "integer" },
        "AGI": { "type": "integer" },
        "CON": { "type": "integer" },
        "VIT": { "type": "integer" },
        "WIS": { "type": "integer" },
        "INT": { "type": "integer" },
        "SPT": { "type": "integer" },
        "CHA": { "type": "integer" }
      }
    },
    "startingSkills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skillLevel" },
      "minItems": 1
    },
    "startingAbilityIds": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "skillLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "level"],
      "properties": {
        "skillId": { "type": "string" },
        "level": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
