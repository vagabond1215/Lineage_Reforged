{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayerSkillRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "domain",
    "parentSkillId",
    "description",
    "leveling",
    "progressionTrackId",
    "governingAttributes",
    "combatHooks",
    "itemHookTags"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["resource", "survival", "combat", "magic", "crafting", "knowledge", "settlement", "leadership"]
    },
    "domain": { "type": "string" },
    "parentSkillId": {
      "type": ["string", "null"]
    },
    "description": { "type": "string" },
    "leveling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultRank", "maximumRank"],
      "properties": {
        "defaultRank": { "type": "integer", "minimum": 1, "maximum": 125 },
        "maximumRank": { "type": "integer", "minimum": 1, "maximum": 125 }
      }
    },
    "progressionTrackId": { "type": "string" },
    "governingAttributes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "combatHooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillEffectIds", "actionGrantTags", "tacticalTags", "titleModifierTags", "spellTags", "resolutionHooks"],
      "properties": {
        "skillEffectIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "actionGrantTags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tacticalTags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "titleModifierTags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "spellTags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "resolutionHooks": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "itemHookTags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "knowledgeTrackId": { "type": "string" },
    "milestoneTitleTrackId": { "type": "string" }
  }
}
