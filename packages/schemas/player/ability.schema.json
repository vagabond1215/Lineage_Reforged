{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlayerAbilityRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description",
    "activation",
    "requirements",
    "targetProfile",
    "governingSkillIds",
    "effectChannels",
    "combatTags",
    "resolutionHooks"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["melee", "ranged", "tactical", "defensive", "command", "reaction"]
    },
    "description": { "type": "string" },
    "activation": { "$ref": "#/$defs/activation" },
    "requirements": { "$ref": "#/$defs/requirements" },
    "targetProfile": { "$ref": "#/$defs/targetProfile" },
    "governingSkillIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "governingAttributeIds": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "effectChannels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "combatTags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "resolutionHooks": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "actionType", "timing", "executionTimeTicks", "recoveryTimeTicks", "interruptible", "costs"],
      "properties": {
        "type": { "type": "string", "enum": ["active", "reaction", "passive"] },
        "actionType": { "type": "string" },
        "timing": { "type": "string" },
        "executionTimeTicks": { "type": "integer", "minimum": 0 },
        "recoveryTimeTicks": { "type": "integer", "minimum": 0 },
        "interruptible": { "type": "boolean" },
        "costs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hp": { "type": "number", "minimum": 0 },
            "mp": { "type": "number", "minimum": 0 },
            "stamina": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillRanks", "attributes", "equipmentTagsAny", "handlingTagsAny", "targetConditionsAny"],
      "properties": {
        "skillRanks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "minRank"],
            "properties": {
              "id": { "type": "string" },
              "minRank": { "type": "integer", "minimum": 0, "maximum": 125 }
            }
          }
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "minValue"],
            "properties": {
              "id": { "type": "string" },
              "minValue": { "type": "number", "minimum": 0 }
            }
          }
        },
        "equipmentTagsAny": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "handlingTagsAny": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "targetConditionsAny": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "condition"],
            "properties": {
              "scope": { "type": "string", "enum": ["actor", "target"] },
              "condition": { "type": "string" },
              "qualifier": { "type": "string" }
            }
          }
        }
      }
    },
    "targetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "shape", "range", "maxTargets", "requiresAccuracy"],
      "properties": {
        "disposition": { "type": "string", "enum": ["ally", "enemy", "self", "any"] },
        "shape": { "type": "string" },
        "range": { "type": "string" },
        "maxTargets": { "type": "integer", "minimum": 1 },
        "requiresAccuracy": { "type": "boolean" }
      }
    }
  }
}
