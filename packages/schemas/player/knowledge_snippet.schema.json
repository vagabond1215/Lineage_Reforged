{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeSnippetRecord",
  "description": "Planning schema for snippet-based knowledge progression. This schema is not wired into runtime content loading yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domainId",
    "subjectType",
    "subjectId",
    "tier",
    "category",
    "title",
    "discoverySources",
    "progression",
    "visibility"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "subjectType": {
      "type": "string",
      "enum": [
        "flora",
        "fauna",
        "mineral",
        "settlement",
        "region",
        "culture",
        "institution",
        "spell",
        "item",
        "ruin",
        "historical_event",
        "custom"
      ]
    },
    "subjectId": { "type": "string", "minLength": 1 },
    "tier": { "type": "integer", "minimum": 1, "maximum": 10 },
    "category": {
      "type": "string",
      "enum": [
        "identification",
        "habitat",
        "behavior",
        "use",
        "byproduct",
        "processing",
        "danger",
        "lookalike",
        "regional_variant",
        "seasonality",
        "trade_value",
        "ritual_use",
        "historical_context",
        "cultural_context",
        "mechanical_application",
        "custom"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredSnippetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "requiredDomainTier": { "type": "integer", "minimum": 0, "maximum": 10 },
        "requiredSkillRanks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skillId", "minimumRank"],
            "properties": {
              "skillId": { "type": "string" },
              "minimumRank": { "type": "integer", "minimum": 0, "maximum": 125 }
            }
          }
        }
      }
    },
    "discoverySources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceType"],
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "field_identification",
              "resource_use",
              "crafting_use",
              "combat_observation",
              "travel_observation",
              "book_study",
              "teacher_instruction",
              "institutional_study",
              "scroll_study",
              "tome_study",
              "quest_event",
              "chronicle_record",
              "custom"
            ]
          },
          "sourceId": { "type": ["string", "null"] },
          "locationScope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "continentId": { "type": ["string", "null"] },
              "regionId": { "type": ["string", "null"] },
              "settlementId": { "type": ["string", "null"] },
              "biomeTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          },
          "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "obscure", "unique"] }
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completionWeight"],
      "properties": {
        "completionWeight": { "type": "number", "exclusiveMinimum": 0 },
        "countsTowardTierCompletion": { "type": "boolean", "default": true },
        "trialUnlockWeight": { "type": "number", "minimum": 0 }
      }
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockedUntilDiscovered", "revealsSubjectIdentity"],
      "properties": {
        "lockedUntilDiscovered": { "type": "boolean" },
        "revealsSubjectIdentity": { "type": "boolean" },
        "hiddenSummary": { "type": "string" }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
