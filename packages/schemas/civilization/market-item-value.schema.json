{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MarketItemValues",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "records"
    ],
    "properties": {
        "records": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "itemKey",
                    "source",
                    "category",
                    "baseValue",
                    "currencyId",
                    "valueUnit",
                    "marketable",
                    "pricingProfile"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "itemKey": {
                        "type": "string",
                        "pattern": "^(?:[a-z0-9]+(?:_[a-z0-9]+)*|[a-z]+\\.[a-z0-9]+(?:_[a-z0-9]+)*)$"
                    },
                    "source": {
                        "type": "string"
                    },
                    "category": {
                        "type": "string"
                    },
                    "baseValue": {
                        "type": "number",
                        "minimum": 0
                    },
                    "currencyId": {
                        "type": "string"
                    },
                    "valueUnit": {
                        "type": "string"
                    },
                    "marketable": {
                        "type": "boolean"
                    },
                    "pricingProfile": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "pricingMode",
                            "materialCostSource",
                            "laborCostSource",
                            "processingCostSource",
                            "difficultySource",
                            "demandBand"
                        ],
                        "properties": {
                            "pricingMode": {
                                "type": "string",
                                "enum": [
                                    "derived_snapshot"
                                ]
                            },
                            "materialCostSource": {
                                "type": "string",
                                "enum": [
                                    "source_effort",
                                    "input_rollup"
                                ]
                            },
                            "laborCostSource": {
                                "type": "string",
                                "enum": [
                                    "recipe_skill_time"
                                ]
                            },
                            "processingCostSource": {
                                "type": "string",
                                "enum": [
                                    "fuel_and_tool_wear"
                                ]
                            },
                            "difficultySource": {
                                "type": "string",
                                "enum": [
                                    "material_and_precision"
                                ]
                            },
                            "demandBand": {
                                "type": "string",
                                "enum": [
                                    "subsistence",
                                    "common",
                                    "utility",
                                    "specialty",
                                    "luxury"
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}
