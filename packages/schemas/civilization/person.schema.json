{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonCollection",
  "description": "Schema for future authored canonical named-person identity. Records are descriptive identity authority only and do not define roles, workplaces, relationships, schedules, dialogue, services, quests, Knowledge, combat, runtime state, UI, storage, rewards, or gameplay behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/personRecord" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "personId": {
      "type": "string",
      "pattern": "^person\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "lineageId": {
      "type": "string",
      "pattern": "^lineage\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "noteList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "sourceAuthorityNotes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "personRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "aliases",
        "summary",
        "lifeStatus",
        "status",
        "sourceAuthorityNotes",
        "notes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/personId" },
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "aliases": { "$ref": "#/$defs/stringList" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "lineageId": { "$ref": "#/$defs/lineageId" },
        "lifeStatus": {
          "type": "string",
          "enum": ["living", "deceased", "unknown"]
        },
        "status": {
          "type": "string",
          "enum": ["planned", "active", "retired"]
        },
        "sourceAuthorityNotes": { "$ref": "#/$defs/sourceAuthorityNotes" },
        "notes": { "$ref": "#/$defs/noteList" }
      }
    }
  }
}
