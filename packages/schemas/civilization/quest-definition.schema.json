{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "sourceReferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceReference" }
    },
    "rankScale": {
      "type": "array",
      "items": { "$ref": "#/$defs/scaleEntry" }
    },
    "riskScale": {
      "type": "array",
      "items": { "$ref": "#/$defs/scaleEntry" }
    },
    "checkKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkKind" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/questDefinition" }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "url": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "scaleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "difficultyBand": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "checkKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "notes"],
      "properties": {
        "id": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "questDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "name",
        "category",
        "summary",
        "giver",
        "requirements",
        "scheduling",
        "classification",
        "deployment",
        "logistics",
        "rewards",
        "miscNotes",
        "actionTree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^quest_definition\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "summary": { "type": "string", "minLength": 1 },
        "giver": { "$ref": "#/$defs/giver" },
        "requirements": { "$ref": "#/$defs/requirements" },
        "scheduling": { "$ref": "#/$defs/scheduling" },
        "classification": { "$ref": "#/$defs/classification" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "logistics": { "$ref": "#/$defs/logistics" },
        "rewards": { "$ref": "#/$defs/rewards" },
        "miscNotes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "actionTree": { "$ref": "#/$defs/actionTree" }
      }
    },
    "giver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entityId", "displayName", "contactName", "settlementId"],
      "properties": {
        "type": { "type": "string" },
        "entityId": { "type": "string" },
        "displayName": { "type": "string" },
        "contactName": { "type": "string" },
        "settlementId": { "type": "string" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levelMin",
        "classTagsAny",
        "requiredSkills",
        "requiredAbilities",
        "requiredSpells",
        "requiredTraits",
        "requiredItems",
        "reputationRequirements",
        "notes"
      ],
      "properties": {
        "levelMin": { "type": "integer", "minimum": 1 },
        "classTagsAny": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredSkills": {
          "type": "array",
          "items": { "$ref": "#/$defs/thresholdRef" }
        },
        "requiredAbilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/idThresholdRef" }
        },
        "requiredSpells": {
          "type": "array",
          "items": { "$ref": "#/$defs/idThresholdRef" }
        },
        "requiredTraits": {
          "type": "array",
          "items": { "$ref": "#/$defs/idThresholdRef" }
        },
        "requiredItems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reputationRequirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/reputationRequirement" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "thresholdRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minRank"],
      "properties": {
        "id": { "type": "string" },
        "minRank": { "type": "integer", "minimum": 0 }
      }
    },
    "idThresholdRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minValue"],
      "properties": {
        "id": { "type": "string" },
        "minValue": { "type": "integer", "minimum": 0 }
      }
    },
    "reputationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minScore"],
      "properties": {
        "id": { "type": "string" },
        "minScore": { "type": "number" }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedDurationHours", "dueWithinHours", "planningWindowHours", "repeatable", "timeSensitivity"],
      "properties": {
        "expectedDurationHours": { "type": "number", "minimum": 1 },
        "dueWithinHours": { "type": "number", "minimum": 1 },
        "planningWindowHours": { "type": "number", "minimum": 0 },
        "repeatable": { "type": "boolean" },
        "timeSensitivity": { "type": "string" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "expectedRisk", "legalExposure", "combatIntensity", "failureProfile"],
      "properties": {
        "rank": { "type": "string" },
        "expectedRisk": { "type": "string" },
        "legalExposure": { "type": "string" },
        "combatIntensity": { "type": "string" },
        "failureProfile": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minPartySize", "recommendedPartySize", "maxPartySize", "soloAllowed", "roleSlots", "partySizeRules"],
      "properties": {
        "minPartySize": { "type": "integer", "minimum": 1 },
        "recommendedPartySize": { "type": "integer", "minimum": 1 },
        "maxPartySize": { "type": "integer", "minimum": 1 },
        "soloAllowed": { "type": "boolean" },
        "roleSlots": {
          "type": "array",
          "items": { "$ref": "#/$defs/roleSlot" }
        },
        "partySizeRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/partySizeRule" }
        }
      }
    },
    "roleSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slotId", "label", "minPeople", "maxPeople", "preferredChecks", "notes"],
      "properties": {
        "slotId": { "type": "string" },
        "label": { "type": "string" },
        "minPeople": { "type": "integer", "minimum": 0 },
        "maxPeople": { "type": "integer", "minimum": 0 },
        "preferredChecks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    },
    "partySizeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "effect"],
      "properties": {
        "condition": { "type": "string" },
        "effect": { "type": "string" }
      }
    },
    "logistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredTools", "recommendedTools", "requiredEquipmentTags", "recommendedSpells", "consumedItems"],
      "properties": {
        "requiredTools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendedTools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requiredEquipmentTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendedSpells": {
          "type": "array",
          "items": { "type": "string" }
        },
        "consumedItems": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coinBase", "coinBonusOnPerfect", "reputationBase", "itemRewards", "unlocks"],
      "properties": {
        "coinBase": { "type": "integer", "minimum": 0 },
        "coinBonusOnPerfect": { "type": "integer", "minimum": 0 },
        "reputationBase": { "type": "integer", "minimum": 0 },
        "itemRewards": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unlocks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "actionTree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entryNodeId", "completionNodeIds", "nodes"],
      "properties": {
        "entryNodeId": { "type": "string" },
        "completionNodeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/actionNode" }
        }
      }
    },
    "actionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "phase",
        "summary",
        "estimatedHours",
        "assignedRoles",
        "participantRange",
        "checks",
        "branches"
      ],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "phase": { "type": "string" },
        "summary": { "type": "string" },
        "estimatedHours": { "type": "number", "minimum": 0 },
        "assignedRoles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "participantRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/actionCheck" }
        },
        "branches": {
          "type": "object",
          "propertyNames": {
            "enum": ["criticalSuccess", "success", "partial", "failure", "criticalFailure"]
          },
          "additionalProperties": { "$ref": "#/$defs/branchOutcome" }
        }
      }
    },
    "actionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId", "minValue", "weight", "optional", "notes"],
      "properties": {
        "kind": { "type": "string" },
        "targetId": { "type": "string" },
        "minValue": { "type": "number" },
        "weight": { "type": "number" },
        "optional": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "branchOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextNodeId", "questState", "summary", "effects"],
      "properties": {
        "nextNodeId": { "type": ["string", "null"] },
        "questState": { "type": "string" },
        "summary": { "type": "string" },
        "effects": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
