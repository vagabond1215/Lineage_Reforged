{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "category",
          "summary",
          "issuingGuildTypes",
          "allowAdventurersFallback",
          "generationSource",
          "targetItemKeys",
          "targetSettlementTags",
          "monsterIds",
          "minimumQuantity",
          "minimumShortfallPerTick",
          "minimumTradeSurplusPerTick",
          "rewardProfile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^quest_template\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "gathering",
              "hunting",
              "domestic_labor",
              "escort",
              "porter",
              "exploration",
              "monster_subjugation",
              "salvage"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "issuingGuildTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "allowAdventurersFallback": {
            "type": "boolean"
          },
          "generationSource": {
            "type": "string",
            "enum": [
              "shortfall",
              "surplus",
              "security",
              "frontier"
            ]
          },
          "targetItemKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "targetSettlementTags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "monsterIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^monster\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "minimumQuantity": {
            "type": "integer",
            "minimum": 1
          },
          "minimumShortfallPerTick": {
            "type": "number",
            "minimum": 0
          },
          "minimumTradeSurplusPerTick": {
            "type": "number",
            "minimum": 0
          },
          "rewardProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "coinBase",
              "standingBase",
              "bonusItemKeys"
            ],
            "properties": {
              "coinBase": {
                "type": "integer",
                "minimum": 0
              },
              "standingBase": {
                "type": "integer",
                "minimum": 0
              },
              "bonusItemKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                }
              },
              "reputationAwards": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reputationAward"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reputationAward": {
      "oneOf": [
        { "$ref": "#/$defs/fameReputationAward" },
        { "$ref": "#/$defs/notorietyReputationAward" }
      ]
    },
    "settlementIdArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^settlement\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    },
    "fameReputationAward": {
      "oneOf": [
        { "$ref": "#/$defs/localFameReputationAward" },
        { "$ref": "#/$defs/regionalFameReputationAward" },
        { "$ref": "#/$defs/continentalFameReputationAward" },
        { "$ref": "#/$defs/worldFameReputationAward" }
      ]
    },
    "localFameReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "branchId", "directEarnedScope", "baseValue", "originSettlementIds"],
      "properties": {
        "axis": { "const": "fame" },
        "branchId": { "type": "string", "enum": ["civic", "folk", "trade", "martial"] },
        "directEarnedScope": { "const": "local" },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": { "$ref": "#/$defs/settlementIdArray" }
      }
    },
    "regionalFameReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "branchId", "directEarnedScope", "baseValue", "originSettlementIds"],
      "properties": {
        "axis": { "const": "fame" },
        "branchId": { "type": "string", "enum": ["heroic", "martial", "political", "commercial"] },
        "directEarnedScope": { "const": "regional" },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": { "$ref": "#/$defs/settlementIdArray" }
      }
    },
    "continentalFameReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "branchId", "directEarnedScope", "baseValue", "originSettlementIds"],
      "properties": {
        "axis": { "const": "fame" },
        "branchId": { "type": "string", "enum": ["historical", "legendary", "political"] },
        "directEarnedScope": { "const": "continental" },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": { "$ref": "#/$defs/settlementIdArray" }
      }
    },
    "worldFameReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "branchId", "directEarnedScope", "baseValue"],
      "properties": {
        "axis": { "const": "fame" },
        "branchId": { "type": "string", "enum": ["legendary", "mythic"] },
        "directEarnedScope": { "const": "world" },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^settlement\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        }
      }
    },
    "notorietyReputationAward": {
      "oneOf": [
        { "$ref": "#/$defs/scopedNotorietyReputationAward" },
        { "$ref": "#/$defs/worldNotorietyReputationAward" }
      ]
    },
    "scopedNotorietyReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "categoryId",
        "severity",
        "directEarnedScope",
        "baseValue",
        "originSettlementIds",
        "exposureRequirement",
        "attributionRequired",
        "allowCredibleLink"
      ],
      "properties": {
        "axis": { "const": "notoriety" },
        "categoryId": {
          "type": "string",
          "enum": ["theft", "fraud", "violent", "murder", "arson", "banditry", "treason"]
        },
        "severity": { "type": "string", "enum": ["minor", "standard", "major"] },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mass",
              "organized",
              "repeat",
              "public",
              "against_nobility",
              "against_temple",
              "wartime",
              "ritual"
            ]
          },
          "uniqueItems": true
        },
        "directEarnedScope": { "type": "string", "enum": ["local", "regional", "continental"] },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": { "$ref": "#/$defs/settlementIdArray" },
        "exposureRequirement": { "type": "string", "enum": ["public", "witnessed_or_reported", "evidenced"] },
        "attributionRequired": { "type": "boolean" },
        "allowCredibleLink": { "type": "boolean" }
      }
    },
    "worldNotorietyReputationAward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "categoryId",
        "severity",
        "directEarnedScope",
        "baseValue",
        "exposureRequirement",
        "attributionRequired",
        "allowCredibleLink"
      ],
      "properties": {
        "axis": { "const": "notoriety" },
        "categoryId": {
          "type": "string",
          "enum": ["theft", "fraud", "violent", "murder", "arson", "banditry", "treason"]
        },
        "severity": { "type": "string", "enum": ["minor", "standard", "major"] },
        "modifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mass",
              "organized",
              "repeat",
              "public",
              "against_nobility",
              "against_temple",
              "wartime",
              "ritual"
            ]
          },
          "uniqueItems": true
        },
        "directEarnedScope": { "const": "world" },
        "baseValue": { "type": "number", "minimum": 0 },
        "originSettlementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^settlement\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        },
        "exposureRequirement": { "type": "string", "enum": ["public", "witnessed_or_reported", "evidenced"] },
        "attributionRequired": { "type": "boolean" },
        "allowCredibleLink": { "type": "boolean" }
      }
    }
  }
}

