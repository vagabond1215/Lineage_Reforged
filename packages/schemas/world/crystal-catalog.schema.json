{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "tier",
          "element",
          "affinityKey",
          "capacity",
          "efficiency",
          "stability",
          "attunementMode",
          "reusable",
          "consumedOnPermanentEnchant",
          "supportedUseCases",
          "rechargeMethod",
          "mismatchPenalty"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^crystal\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["shard", "crystal", "cluster"]
          },
          "element": {
            "type": "string",
            "enum": ["neutral", "light", "water", "wind", "ice", "darkness", "fire", "stone", "earth", "thunder"]
          },
          "affinityKey": {
            "type": "string",
            "enum": ["neutral", "light", "water", "wind", "ice", "darkness", "fire", "earth", "thunder"]
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "efficiency": {
            "type": "number",
            "minimum": 0.1
          },
          "stability": {
            "type": "number",
            "minimum": 0.1
          },
          "attunementMode": {
            "type": "string",
            "enum": ["fixed", "attunable"]
          },
          "reusable": {
            "type": "boolean"
          },
          "consumedOnPermanentEnchant": {
            "type": "boolean"
          },
          "supportedUseCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "rechargeMethod": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "mismatchPenalty": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
