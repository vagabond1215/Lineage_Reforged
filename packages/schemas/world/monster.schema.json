{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "monsterClass",
          "threat",
          "summary",
          "habitatTags",
          "behaviorTags",
          "drops",
          "loot",
          "combatProfile",
          "defaultRole",
          "actionPackageIds",
          "difficultyScalingHooks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^monster\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "monsterClass": {
            "type": "string",
            "enum": [
              "beast",
              "humanoid",
              "ooze",
              "elemental",
              "undead",
              "giantkin"
            ]
          },
          "threat": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "severe"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "habitatTags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "behaviorTags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "drops": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemKey",
                "quantityMin",
                "quantityMax",
                "chance"
              ],
              "properties": {
                "itemKey": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                "quantityMin": {
                  "type": "integer",
                  "minimum": 1
                },
                "quantityMax": {
                  "type": "integer",
                  "minimum": 1
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "loot": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "itemKey",
                "chance"
              ],
              "properties": {
                "itemKey": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "baseFaunaId": {
            "type": "string",
            "pattern": "^fauna\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "baseMonsterId": {
            "type": "string",
            "pattern": "^monster\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "variantType": {
            "type": "string",
            "enum": [
              "species_only",
              "biological",
              "evolved",
              "elemental",
              "material",
              "cursed",
              "transformed",
              "supernatural"
            ]
          },
          "attunementLevel": {
            "type": "string",
            "enum": ["unattuned", "low", "moderate", "high"]
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["neutral", "fire", "water", "earth", "stone", "wind", "thunder", "ice", "light", "darkness"]
            },
            "uniqueItems": true
          },
          "originProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["appearanceRate", "terrainSources", "entryVectors", "secureSettlementRule"],
            "properties": {
              "appearanceRate": {
                "type": "string",
                "enum": ["common", "uncommon", "rare", "lair_only"]
              },
              "terrainSources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                }
              },
              "entryVectors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
                }
              },
              "secureSettlementRule": {
                "type": "string",
                "enum": [
                  "blocked_without_open_path",
                  "requires_subsurface_access",
                  "requires_open_water_access",
                  "can_bypass_if_airspace_unsecured",
                  "requires_affinity_breach",
                  "summoned_only"
                ]
              }
            }
          },
          "combatProfile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseHp",
              "baseMp",
              "baseStamina",
              "baseAccuracy",
              "baseDefense",
              "baseEvasion",
              "baseAttackSpeed",
              "baseRecoverySpeed",
              "threatRating",
              "preferredRange"
            ],
            "properties": {
              "baseHp": { "type": "integer", "minimum": 1 },
              "baseMp": { "type": "integer", "minimum": 0 },
              "baseStamina": { "type": "integer", "minimum": 1 },
              "baseAccuracy": { "type": "integer", "minimum": 0 },
              "baseDefense": { "type": "integer", "minimum": 0 },
              "baseEvasion": { "type": "integer", "minimum": 0 },
              "baseAttackSpeed": { "type": "integer", "minimum": 1 },
              "baseRecoverySpeed": { "type": "integer", "minimum": 1 },
              "threatRating": { "type": "integer", "minimum": 0 },
              "preferredRange": {
                "type": "string",
                "enum": ["melee", "ranged", "magic"]
              }
            }
          },
          "defaultRole": {
            "type": "string",
            "enum": [
              "frontliner",
              "disruptor",
              "ranged_pressure",
              "healer",
              "support_buffer",
              "debuffer_controller",
              "opportunist",
              "tank_protector",
              "flexible_adaptive"
            ]
          },
          "actionPackageIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "difficultyScalingHooks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hpPerTier",
              "mpPerTier",
              "staminaPerTier",
              "accuracyPerTier",
              "defensePerTier",
              "actionTimeMultiplierPerTier",
              "recoveryMultiplierPerTier"
            ],
            "properties": {
              "hpPerTier": { "type": "number", "minimum": 0 },
              "mpPerTier": { "type": "number", "minimum": 0 },
              "staminaPerTier": { "type": "number", "minimum": 0 },
              "accuracyPerTier": { "type": "number", "minimum": 0 },
              "defensePerTier": { "type": "number", "minimum": 0 },
              "actionTimeMultiplierPerTier": { "type": "number", "minimum": 0 },
              "recoveryMultiplierPerTier": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
