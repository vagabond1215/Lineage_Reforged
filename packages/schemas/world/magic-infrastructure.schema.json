{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "category",
          "summary",
          "requiredInfrastructure",
          "requiredGuildTypes",
          "requiredReligionOrganizationIds",
          "supportedUseCases",
          "prohibitedBypassTags",
          "preferredCrystalTiers",
          "allowedElements",
          "serviceScaleBand"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^magic_service\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": ["adventurer_magic", "utility_enchantment", "ritual_religious"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "requiredInfrastructure": {
            "type": "object",
            "additionalProperties": false,
            "required": ["roadTier", "waterTier", "harborTier", "marketTier", "fortificationTier"],
            "properties": {
              "roadTier": { "type": "integer", "minimum": 0, "maximum": 5 },
              "waterTier": { "type": "integer", "minimum": 0, "maximum": 5 },
              "harborTier": { "type": "integer", "minimum": 0, "maximum": 5 },
              "marketTier": { "type": "integer", "minimum": 0, "maximum": 5 },
              "fortificationTier": { "type": "integer", "minimum": 0, "maximum": 5 }
            }
          },
          "requiredGuildTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "requiredReligionOrganizationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^religious_order\\.[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "supportedUseCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "prohibitedBypassTags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
            }
          },
          "preferredCrystalTiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["shard", "crystal", "cluster"]
            }
          },
          "allowedElements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["neutral", "light", "water", "wind", "ice", "darkness", "fire", "stone", "earth", "thunder"]
            }
          },
          "serviceScaleBand": {
            "type": "string",
            "enum": ["small", "moderate", "large"]
          }
        }
      }
    }
  }
}
