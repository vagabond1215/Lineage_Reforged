{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BiomeRecord",
  "type": "object",
  "required": ["id", "slug", "name", "climateBand", "baseFertility", "hazards"],
  "properties": {
    "id": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": { "type": "string" },
    "climateBand": {
      "type": "string",
      "enum": ["desert", "subterranean", "temperate", "wetlands", "polar", "shrublands", "marine", "tropical", "grasslands"]
    },
    "baseFertility": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "hazards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    }
  },
  "additionalProperties": false
}
