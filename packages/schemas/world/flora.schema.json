{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FloraRecord",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name",
    "type",
    "lifecycle",
    "habitatIds",
    "harvest",
    "baseValue",
    "currencyId",
    "template"
  ],
  "properties": {
    "id": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "name": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["tree", "shrub", "herb", "grass", "fungi"]
    },
    "lifecycle": {
      "type": "string",
      "enum": ["annual", "biennial", "perennial"]
    },
    "habitatIds": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "harvest": {
      "type": "object",
      "required": ["active", "passive", "yieldCap"],
      "properties": {
        "active": { "type": "boolean" },
        "passive": { "type": "boolean" },
        "yieldCap": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "baseValue": { "type": "number", "minimum": 0 },
    "currencyId": { "type": "string" },
    "template": {
      "type": "object",
      "required": ["identity", "harvest", "lifecycle", "agronomy", "domestication", "ecology"],
      "properties": {
        "identity": {
          "type": "object",
          "required": ["name", "type"],
          "properties": {
            "name": { "type": "string" },
            "type": {
              "type": "string",
              "enum": ["tree", "shrub", "herb", "grass", "fungi"]
            }
          },
          "additionalProperties": false
        },
        "harvest": {
          "type": "object",
          "required": [
            "harvestableParts",
            "partHarvestAvailability",
            "partPassiveHarvestRules",
            "partActiveHarvestRules",
            "tools",
            "triggers",
            "activeHarvest",
            "passiveHarvest"
          ],
          "properties": {
            "harvestableParts": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "partHarvestAvailability": {
              "type": "object",
              "required": ["active", "passive", "partsByStages"],
              "properties": {
                "active": { "type": "boolean" },
                "passive": { "type": "boolean" },
                "partsByStages": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["stage", "parts"],
                    "properties": {
                      "stage": {
                        "type": "string",
                        "enum": ["germination", "vegetative", "flowering", "fruiting", "dormancy"]
                      },
                      "parts": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "partPassiveHarvestRules": {
              "type": "object",
              "required": ["passiveYieldStartAgeDays", "yieldCapAnnual", "regrowthBehavior"],
              "properties": {
                "passiveYieldStartAgeDays": { "type": "integer", "minimum": 0 },
                "yieldCapAnnual": { "type": "integer", "minimum": 0 },
                "regrowthBehavior": {
                  "type": "object",
                  "required": ["unitsPerGrowthSeasonWhenMature"],
                  "properties": {
                    "unitsPerGrowthSeasonWhenMature": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "partActiveHarvestRules": {
              "type": "object",
              "required": ["primeYieldAges", "regrowthBehavior", "activeHarvestImpact", "unharvestedConversion"],
              "properties": {
                "primeYieldAges": {
                  "type": "object",
                  "required": ["startAgeDays", "peakAgeDays", "endAgeDays"],
                  "properties": {
                    "startAgeDays": { "type": "integer", "minimum": 0 },
                    "peakAgeDays": { "type": "integer", "minimum": 0 },
                    "endAgeDays": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                },
                "regrowthBehavior": {
                  "type": "object",
                  "required": ["growthCyclesPerSeason", "unitGrowthSpeed", "matureAgeDays"],
                  "properties": {
                    "growthCyclesPerSeason": { "type": "number", "minimum": 0 },
                    "unitGrowthSpeed": { "type": "number", "minimum": 0 },
                    "matureAgeDays": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                },
                "activeHarvestImpact": {
                  "type": "object",
                  "required": ["harvestableStructuralUnits", "destructiveHarvestFlag"],
                  "properties": {
                    "harvestableStructuralUnits": { "type": "integer", "minimum": 0 },
                    "destructiveHarvestFlag": {
                      "type": "object",
                      "required": [
                        "passiveYieldEffectPerHarvest",
                        "allPartGrowthSpeedReductionPerHarvest",
                        "maximumDestructiveHarvestsToStagnation",
                        "maximumDestructiveHarvestsToDeath",
                        "canRegrow",
                        "timeToRegrowDays",
                        "regrowthPeriod"
                      ],
                      "properties": {
                        "passiveYieldEffectPerHarvest": { "type": "number", "minimum": 0 },
                        "allPartGrowthSpeedReductionPerHarvest": { "type": "number", "minimum": 0 },
                        "maximumDestructiveHarvestsToStagnation": { "type": "integer", "minimum": 0 },
                        "maximumDestructiveHarvestsToDeath": { "type": "integer", "minimum": 0 },
                        "canRegrow": { "type": "boolean" },
                        "timeToRegrowDays": { "type": "integer", "minimum": 0 },
                        "regrowthPeriod": {
                          "type": "string",
                          "enum": ["none", "growth_season", "annual"]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "unharvestedConversion": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "tools": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "triggers": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "activeHarvest": {
              "type": "object",
              "required": ["trigger", "rawOutput"],
              "properties": {
                "trigger": { "type": "string" },
                "rawOutput": {
                  "type": "object",
                  "required": ["materials", "ingredients", "processing"],
                  "properties": {
                    "materials": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    },
                    "ingredients": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    },
                    "processing": {
                      "type": "object",
                      "required": ["byProducts"],
                      "properties": {
                        "byProducts": {
                          "type": "object",
                          "required": ["materials", "ingredients"],
                          "properties": {
                            "materials": {
                              "type": "array",
                              "items": { "type": "string" },
                              "minItems": 1
                            },
                            "ingredients": {
                              "type": "array",
                              "items": { "type": "string" },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "passiveHarvest": {
              "type": "object",
              "required": ["trigger", "rawOutput"],
              "properties": {
                "trigger": { "type": "string" },
                "rawOutput": {
                  "type": "object",
                  "required": ["materials", "ingredients", "processing"],
                  "properties": {
                    "materials": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    },
                    "ingredients": {
                      "type": "array",
                      "items": { "type": "string" },
                      "minItems": 1
                    },
                    "processing": {
                      "type": "object",
                      "required": ["byProducts"],
                      "properties": {
                        "byProducts": {
                          "type": "object",
                          "required": ["materials", "ingredients"],
                          "properties": {
                            "materials": {
                              "type": "array",
                              "items": { "type": "string" },
                              "minItems": 1
                            },
                            "ingredients": {
                              "type": "array",
                              "items": { "type": "string" },
                              "minItems": 1
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "lifecycle": {
          "type": "object",
          "required": ["type", "applicableStages", "stages"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["annual", "biennial", "perennial"]
            },
            "applicableStages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["germination", "vegetative", "flowering", "fruiting", "dormancy"]
              },
              "minItems": 1
            },
            "stages": {
              "type": "object",
              "required": ["germination", "vegetative", "flowering", "fruiting", "dormancy"],
              "properties": {
                "germination": { "$ref": "#/$defs/lifecycleStage" },
                "vegetative": { "$ref": "#/$defs/lifecycleStage" },
                "flowering": { "$ref": "#/$defs/lifecycleStage" },
                "fruiting": { "$ref": "#/$defs/lifecycleStage" },
                "dormancy": { "$ref": "#/$defs/lifecycleStage" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "agronomy": {
          "type": "object",
          "required": [
            "plantingWindow",
            "companionCrops",
            "rotationBenefit",
            "antagonisticCrops",
            "harvestWindow",
            "shedSeasons",
            "growthSeasons"
          ],
          "properties": {
            "plantingWindow": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "companionCrops": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "rotationBenefit": {
              "type": "object",
              "required": ["soilQuality", "fertilizationEffect", "survivability", "pestInteraction"],
              "properties": {
                "soilQuality": { "type": "number" },
                "fertilizationEffect": { "type": "number" },
                "survivability": { "type": "number" },
                "pestInteraction": { "type": "number" }
              },
              "additionalProperties": false
            },
            "antagonisticCrops": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "harvestWindow": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "shedSeasons": {
              "type": "array",
              "items": { "type": "string" }
            },
            "growthSeasons": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        "domestication": {
          "type": "object",
          "required": ["cultivable", "domesticVariant", "domesticationYieldModifier", "tools", "difficulty", "mediation", "infrastructure"],
          "properties": {
            "cultivable": { "type": "boolean" },
            "domesticVariant": { "type": ["string", "null"] },
            "domesticationYieldModifier": { "type": "number", "minimum": 0 },
            "tools": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "difficulty": {
              "type": "object",
              "required": ["invasivity", "fragilityFactors", "soilDegradation", "survivability", "landArea"],
              "properties": {
                "invasivity": { "type": "number" },
                "fragilityFactors": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "soilDegradation": { "type": "number" },
                "survivability": { "type": "number" },
                "landArea": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            },
            "mediation": {
              "type": "object",
              "required": ["protection", "pollination", "upkeep"],
              "properties": {
                "protection": {
                  "type": "object",
                  "required": ["fences", "netting"],
                  "properties": {
                    "fences": { "type": "boolean" },
                    "netting": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "pollination": {
                  "type": "object",
                  "required": ["fertilization"],
                  "properties": {
                    "fertilization": { "type": "boolean" }
                  },
                  "additionalProperties": false
                },
                "upkeep": {
                  "type": "object",
                  "required": ["weedControl", "fungusControl"],
                  "properties": {
                    "weedControl": { "type": "boolean" },
                    "fungusControl": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "infrastructure": {
              "type": "object",
              "required": ["irrigation", "greenhouse", "mulch", "trellising", "raisedBeds"],
              "properties": {
                "irrigation": { "type": "boolean" },
                "greenhouse": { "type": "boolean" },
                "mulch": { "type": "boolean" },
                "trellising": { "type": "boolean" },
                "raisedBeds": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ecology": {
          "type": "object",
          "required": ["climateRange", "waterNeed", "lightNeed", "biomes", "soilType"],
          "properties": {
            "climateRange": { "type": "string" },
            "waterNeed": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "lightNeed": {
              "type": "string",
              "enum": ["low", "medium", "high"]
            },
            "biomes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["habitatId", "prevalence"],
                "properties": {
                  "habitatId": { "type": "string" },
                  "prevalence": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "soilType": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "lifecycleStage": {
      "type": "object",
      "required": ["mortalityThreshold", "transitionTriggers", "duration"],
      "properties": {
        "mortalityThreshold": { "type": "number", "minimum": 0 },
        "transitionTriggers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "duration": {
          "type": "object",
          "required": ["baseDurationDays", "environmentalVariability"],
          "properties": {
            "baseDurationDays": { "type": "integer", "minimum": 0 },
            "environmentalVariability": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
